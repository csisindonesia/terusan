node_modules/
dist/
.output/
.vinxi/
.nitro/
.tanstack/
*.tsbuildinfo

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ---- Go ----
/services/api/bin/
/services/api/api

