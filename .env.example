# Storage profile: local | shared-dev | staging | production
# See program.md §45.4. Default is `local` when unset — never defaults to a shared backend.
STORAGE_PROFILE=local

# Backend: local | nas | s3
STORAGE_BACKEND=local

# Logical root for raw/ bronze/ silver/ gold/ exports/ temporary/
#   local       ./.data
#   shared-dev  /Volumes/research/terusan
#   staging     s3://terusan-staging
#   production  s3://terusan-warehouse
STORAGE_ROOT=./.data

# Scratch: local SSD only. Never point this at NAS (program.md §45.6).
SCRATCH_DIR=./.cache

# ---- Hand-delivered material ----
# VEWS publishes its yearly collective violence exports by hand rather than on
# a portal, so the source reads them out of a directory instead of fetching
# them. Relative paths anchor to the project root. Default: tmp/vews
VEWS_DROP_DIR=tmp/vews

# The HS6 RCA working files (.dta) the rca-seed source lands once, as the base
# years before WITS takes over. Default: tmp/rca
RCA_DROP_DIR=tmp/rca

# ---- Object storage (STORAGE_BACKEND=s3) ----
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true

# ---- Application database (program.md §48) ----
DATABASE_URL=postgres://terusan:terusan@localhost:5432/terusan?sslmode=disable

# ---- Serving layer ----
API_HOST=127.0.0.1
API_PORT=8080

# Origins allowed to call the API from a browser. An allow-list rather than a
# wildcard: restricted datasets should not be readable from any page a browser
# happens to load (program.md §36).
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Running pipelines from the portal ----
# The serving layer reads the lake and does not change it, with one deliberate
# exception: with this set, `POST /v1/sources/<slug>/run` starts the scraper
# behind a series, which is what the portal's "run ingestion now" calls. It
# writes no figure itself — the pipeline lands what it finds in RAW and
# journals the run exactly as it does from a terminal.
#
# Off unless set, and it should stay off anywhere the API is reachable by
# people who should not be able to start jobs on the host: there is no
# authentication in front of it (program.md §34). `make dev` switches it on for
# the local stack, which is the case it is for.
#
# The slug is checked against the source registry in the lake before it reaches
# a command line, and no shell is involved.
PIPELINES_ENABLED=false
# The repository root. Found by walking up from the working directory when
# unset, which is right for `make dev` and wrong for a deployment that unpacked
# the API somewhere else.
PIPELINES_ROOT=
# The uv binary. Resolved on PATH at startup, so a server that cannot run what
# it advertises refuses to start rather than failing on the first click.
PIPELINES_UV=uv
# When a run is considered hung and its process group is stopped.
PIPELINES_TIMEOUT_SECONDS=1800
# How many runs may go at once, across every source. The runner also refuses a
# second run of a source already being ingested, so a repeated click cannot
# fork two scrapers at one publisher.
PIPELINES_MAX_CONCURRENT=2

# ---- Application database: collections, saved queries, accounts ----
# The two things the serving layer stores rather than derives: folders of
# records somebody assembled with the filters worth re-running, and the
# accounts people log in with. Point this at a file and /v1/collections and
# /v1/auth answer — which is what gives a folder a URL anyone can open,
# /collections/<id> in the portal. Leave it empty and the portal keeps
# collections in the browser and shows no login, because there is nothing to
# log in to.
#
# Beside the lake rather than in it. The lake is pipeline-written and
# immutable (program.md §45.3); these are the things here a person wrote.
APP_DB=./.data/app.duckdb
# Whether the collection routes accept changes. A session says who is reading
# but does not yet scope what they may change (program.md §34), so a deployment
# reachable by people who should not be editing the shelf serves it read-only.
COLLECTIONS_WRITE=true

# ---- Accounts and sessions ----
# Accounts exist wherever APP_DB does. Create one with:
#   cd services/api && go run ./cmd/authctl create -email you@example.org
#
# Whether a session (or an API token) is needed to read *anything*. On by
# default: everything but the health probes, the capability report and the
# login routes needs one, and the API refuses to start without APP_DB. Set it to
# false only to serve the lake to anyone who can reach it.
# Scripts authenticate with `Authorization: Bearer trs_…`, a token made on the
# account page or with `go run ./cmd/authctl token -email … -name …`.
AUTH_REQUIRED=true
# Roles: admin (manages accounts from Access → Users), researcher (the ordinary
# account) and guest (a researcher with an end date). The login page offers
# "Request access", which creates a pending researcher an admin approves; turn
# it off to issue accounts only from the Users page or authctl.
AUTH_REGISTRATION=true
# Take the client address and location for the access log from the proxy's
# headers (CF-Connecting-IP, CF-IPCountry, CF-IPCity). Set it only where
# Cloudflare or another proxy is the only way to reach the API — anyone who
# can reach it directly can write those headers. City and region need
# Cloudflare's "Add visitor location headers" managed transform.
AUTH_TRUST_PROXY=false
# How long a login lasts, and how long "remember for 30 days" lasts instead.
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=30
# Force Secure on the session cookie. Set it where TLS is terminated by a proxy
# in front of this process, which cannot otherwise tell that the portal is
# served over https.
AUTH_SECURE_COOKIES=false
# PBKDF2-HMAC-SHA256 work factor for new passwords. OWASP's floor is 600000 and
# only goes up; raising it re-hashes each password the next time it is set.
AUTH_PBKDF2_ITERATIONS=600000

# ---- Response cache (program.md §24) ----
# Where the serving layer caches rendered responses. Optional: unset, the API
# derives every response from Parquet, which is correct and slower — the
# aggregates the portal asks for cost hundreds of milliseconds each.
#
# Set, and a configured Redis that cannot be reached is a startup failure
# rather than a silent miss on every request: somebody expected caching, and
# finding out from a latency graph is worse than not starting.
REDIS_URL=redis://localhost:6379/0

# How long a cached response is served before it is derived again. This is the
# bound on how stale an answer can be after a pipeline run finishes.
CACHE_TTL_SECONDS=60

# ---- DuckDB ----
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

# ---- Source credentials ----
# HDX (CKAN) API token: https://data.humdata.org/user/<you>/api-tokens
# Optional. Unset, the HDX source still collects the public CSVs; set, every
# request to HDX carries it, which is what keeps a hundred-megabyte download
# from being rate-limited as an anonymous caller.
HDX_API_TOKEN=

# A BPS web API key, from https://webapi.bps.go.id/developer. Free, issued per
# registered application. Without it `bps-webapi` collects nothing, and BPS is
# the primary statistical source for the country.
BPS_API_KEY=

# An API key for satudata.kemendag.go.id, issued by the trade ministry's data
# unit. Without it the portal answers `API Key not found`.
KEMENDAG_API_KEY=

# An API key for the food price panel (api-panelhargav2.badanpangan.go.id).
# The dashboard is public; the API behind it is not, any more.
PANEL_HARGA_API_KEY=

# Google Earth Engine, for `gee-air-quality`. A Cloud project registered for
# Earth Engine (noncommercial use is free), and either a one-off
# `earthengine authenticate` on this machine or a service account key for an
# unattended run. Without the project the source collects nothing.
EE_PROJECT=
EE_SERVICE_ACCOUNT_KEY=

# ---- News monitoring ----
# The classifier that codes articles (typesafe/jev on Workers AI). Without an
# account id and token the crawl still runs, but every article it finds lands
# as an uncoded candidate.
CF_ACCOUNT_ID=
JEV_CLOUDFLARE=
# Optional: route the classifier through a named AI Gateway, which is how this
# project's spend gets its own meter.
AI_GATEWAY_ID=

# The assistant (/assistant in the portal) runs on the same account. It uses
# CF_AI_TOKEN where set, and the classifier's token above otherwise; either
# needs Workers AI read/run. Without an account and a token the chat is hidden.
CF_AI_TOKEN=
# ASSISTANT_MODEL=@cf/zai-org/glm-4.7-flash
# Every question is first routed and screened by Jev (typesafe/jev, same
# account and token): whether to search regulations, and whether to refuse an
# injection attempt, a harmful request or an off-topic one without calling the
# model above. `off` leaves routing to keywords; the chat works either way.
# ASSISTANT_ROUTER_MODEL=typesafe/jev

# The second reader: a large model, called only for the codings the classifier
# was unsure of. Unset, that stage is skipped and ambiguous codings land
# carrying the confidences that say so — nothing else changes.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Any OpenAI-compatible chat endpoint works here; the provider is a base URL.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# How ambiguous is ambiguous. `BAND` is how near the gate threshold counts as
# undecided; `MIN_CONFIDENCE` is the confidence below which a coded field is
# treated as unanswered. Both widen the escalation rate, which is what the
# second reader costs.
# NEWS_DEEP_BAND=0.15
# NEWS_DEEP_MIN_CONFIDENCE=0.55

# ---- Docker (compose.yaml) ----
# The host path holding the lake. On a shared folder rather than in a Docker
# volume, so the figures stay readable by people and other machines. Spaces are
# fine and need no quotes here; a Windows host writes it as
# D:/Shared Folder/terusan, forward slashes and all.
DATA_DIR=/Volumes/Shared Folder/terusan
# The API's URL as a *browser* sees it, baked into the portal's bundle at build
# time. Not http://api:8080 — that name resolves only between containers.
PUBLIC_API_URL=http://localhost:8080
PORTAL_PORT=3000
