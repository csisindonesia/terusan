# The NAS deployment's .env, as it lives at NAS_DIR/app/.env on the box.
#
# `scripts/nas-deploy.sh` copies this file there the first time and never
# overwrites it afterwards, because the password below is generated on first
# deploy and the catalog keeps its data.
#
# Everything here is read by compose.yaml and infra/nas/compose.nas.yaml.
# Paths are paths *on the NAS*, not on the laptop that deploys.

# ---- Where things live on the NAS ----------------------------------------
# The lake: raw/ bronze/ silver/ gold/ exports/ temporary/, bind-mounted at
# /data in every container that touches figures. On the share rather than in a
# Docker volume, so the figures stay readable over SMB and by whatever else
# the NAS runs.
DATA_DIR=/volume2/terusan/lake

# The connector's config and credentials, mounted read-only at
# /etc/cloudflared. Written by scripts/nas-tunnel-install.sh.
CLOUDFLARED_DIR=/volume2/terusan/cloudflared

# ---- The public face ------------------------------------------------------
# One hostname serves both halves; Cloudflare splits them by path
# (infra/cloudflare/config.nas.yml). The API's URL is baked into the portal's
# bundle at build time, so changing it means rebuilding, not restarting.
PUBLIC_ORIGIN=https://terusan.csis.or.id
PUBLIC_API_URL=https://terusan.csis.or.id

# ---- Microsoft 365 sign-in -------------------------------------------------
# "Log in with Microsoft" on the login page, against the office's Entra ID
# tenant. Off while AUTH_MICROSOFT_CLIENT_ID is empty. The app registration and
# what each of these means are in docs/running-it.md ("Microsoft 365 sign-in").
AUTH_MICROSOFT_TENANT_ID=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_REDIRECT_URL=https://terusan.csis.or.id/v1/auth/microsoft/callback
AUTH_MICROSOFT_DOMAINS=csis.or.id
# Everyone on AUTH_MICROSOFT_DOMAINS is a researcher from their first sign-in;
# an admin changes the role or disables the account afterwards. "pending"
# makes an admin approve each one instead, "refuse" admits only accounts an
# admin already created.
AUTH_MICROSOFT_NEW_ACCOUNTS=active

# ---- Ports on the LAN -----------------------------------------------------
# For reaching the box from the house — the tunnel does not use them, and the
# services reach each other by container name. Pick numbers UGOS is not
# already serving on: 80, 443, 5000, 5001, 9443 and 9999 belong to the NAS
# itself, and UGOS runs its own PostgreSQL on 127.0.0.1:5432 — publishing the
# catalog there fails with "address already in use".
API_PORT=8080
PORTAL_PORT=3000
POSTGRES_PORT=55432

# ---- The catalog ----------------------------------------------------------
# Reached by container name on the compose network. The password is generated
# on the first deploy; changing it here after PostgreSQL's volume exists does
# not change the password in the database.
POSTGRES_USER=terusan
POSTGRES_PASSWORD=__GENERATED__
POSTGRES_DB=terusan
DATABASE_URL=postgres://terusan:__GENERATED__@postgres:5432/terusan?sslmode=disable

# ---- Resources ------------------------------------------------------------
# A DXP2800 has 8 GB and is also serving files.
DUCKDB_MEMORY_LIMIT=3GB
# The response cache's ceiling. Everything in it can be rebuilt from the lake,
# so when it is full it drops the least recently used entries.
REDIS_MAXMEMORY=256mb
