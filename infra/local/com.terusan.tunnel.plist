<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Cloudflare connector, as a launchd user agent.

  A template: `make tunnel-service` substitutes __CLOUDFLARED__, __CONFIG__ and
  the PATH, then loads it.

  A user agent rather than `sudo cloudflared service install`, which installs a
  LaunchDaemon: the credentials it needs live in this user's ~/.cloudflared, and
  a daemon running as root would have to be given a copy of them. The cost is
  that the tunnel is up while this user is logged in — which is the same
  condition the stack beside it already has.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.terusan.tunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>__CLOUDFLARED__</string>
        <string>--no-autoupdate</string>
        <string>--config</string>
        <string>__CONFIG__</string>
        <string>tunnel</string>
        <string>run</string>
        <string>terusan</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/.cache/logs/tunnel.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/.cache/logs/tunnel.err.log</string>
</dict>
</plist>
